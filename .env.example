# =============================================================================
# 1minitman · environment variables
# =============================================================================
# HOW TO USE
#   1. cp .env.example .env.development      (never commit .env.development)
#   2. Section 1 already works for local development as written. Leave it.
#   3. Fill a vendor section only when you start building the feature that needs it.
#
# RULES
#   - One file at the repo root feeds every app. Nothing reads a per-app .env.
#   - A value reaches the browser or the phone ONLY if its name starts with
#     VITE_ (admin, web app), PUBLIC_ (website) or EXPO_PUBLIC_ (member app).
#     Never give a secret one of those prefixes.
#   - Hosted environments (staging, production) do not use this file: set the same
#     names in Railway (API, worker), Cloudflare Pages (admin, web, site) and EAS (app).
#
# LEGEND   [required] needed to run locally   [later] needed when that feature is built
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core · [required] · works as-is with `pnpm dev`
# -----------------------------------------------------------------------------
# local | dev | demo | staging | production  (Technical Reference 4.4)
APP_ENV=local
APP_VERSION=0.1.0
# debug | info | warn | error
LOG_LEVEL=info

# Port the API listens on.
API_PORT=4000

# PostgreSQL 16 + PostGIS. Local: the docker-compose database (started by `pnpm dev`).
# Hosted: Neon -> console.neon.tech -> Project -> Connection Details -> "Pooled connection".
DATABASE_URL=postgres://minitman:minitman@localhost:5432/minitman
# Direct (non-pooled) URL for migrations and the job queue. Local: same as DATABASE_URL.
# Hosted: Neon -> Connection Details -> untick "Connection pooling".
DATABASE_MIGRATION_URL=postgres://minitman:minitman@localhost:5432/minitman

# Redis. Local: docker-compose. Hosted: Upstash -> console.upstash.com -> Redis -> your
# database -> "Connect" -> the rediss:// URL (TLS).
REDIS_URL=redis://localhost:6379

# Browser origins allowed to call the API (comma separated): admin, web app, website.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4321

# Where each client finds the API. Same value, three prefixes (see RULES above).
# Testing on a real phone: replace "localhost" in EXPO_PUBLIC_API_URL with your computer's
# Wi-Fi address (macOS: `ipconfig getifaddr en0`), e.g. http://192.168.1.20:4000
VITE_API_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Public address of the website (canonical links, sitemap, QR codes).
PUBLIC_SITE_URL=http://localhost:4321

# -----------------------------------------------------------------------------
# 2. Expo / EAS · member app builds · [required for builds, not for `pnpm dev`]
# -----------------------------------------------------------------------------
# Robot token for the "minitnetwork" Expo account. Lets EAS CLI and CI build, submit
# and publish updates without a personal login.
# Get it: expo.dev -> Account settings -> Access tokens -> Create (robot user: "Engineer").
EXPO_TOKEN=

# -----------------------------------------------------------------------------
# 3. Auth and sessions · [later: auth module]
# -----------------------------------------------------------------------------
# Member access tokens are JWTs signed with EdDSA (Ed25519), 15 minutes.
# Generate a key pair:  openssl genpkey -algorithm ed25519 -out jwt.pem
#                       openssl pkey -in jwt.pem -pubout -out jwt.pub
# Paste each file as one line with \n for line breaks.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Signs the admin console session cookie. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Secret header Cloudflare adds so the API only accepts traffic that came through it.
# Generate: openssl rand -hex 32   (set the same value in a Cloudflare Transform Rule)
ORIGIN_SHARED_SECRET=

# Google sign-in. console.cloud.google.com -> APIs & Services -> Credentials ->
# Create OAuth client ID (one each for Web, iOS and Android).
GOOGLE_OAUTH_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_ANDROID_CLIENT_ID=
# Sign in with Apple. developer.apple.com -> Certificates, IDs & Profiles ->
# Identifiers (Services ID) and Keys (Sign in with Apple key, .p8).
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# 4. Media storage · Cloudflare R2 (S3-compatible) · [later: media module]
# -----------------------------------------------------------------------------
# dash.cloudflare.com -> R2 -> Manage R2 API Tokens -> Create token (Object Read & Write).
# The account id is on the R2 overview page. Create buckets with EU jurisdiction.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_QUARANTINE=media-quarantine
R2_BUCKET_ORIGINALS=media-originals
R2_BUCKET_VARIANTS=media-variants
R2_BUCKET_EXPORTS=exports
R2_BUCKET_BACKUPS=backups

# -----------------------------------------------------------------------------
# 5. AWS · face liveness and encryption keys only · [later: Black Badge]
# -----------------------------------------------------------------------------
# console.aws.amazon.com -> IAM -> Users -> create a user with a policy limited to
# Rekognition Face Liveness and one KMS key -> Security credentials -> Create access key.
# Pay per liveness check; no monthly fee.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# KMS -> Customer managed keys -> Create key (symmetric) -> copy the key ARN.
AWS_KMS_KEY_ID=

# -----------------------------------------------------------------------------
# 6. Billing · [later: billing module]
# -----------------------------------------------------------------------------
# RevenueCat (App Store + Google Play purchases inside the app).
# app.revenuecat.com -> Project -> API keys. "Secret" key for the API, public SDK keys per store.
REVENUECAT_SECRET_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Project -> Integrations -> Webhooks -> set an Authorization header value and paste it here.
REVENUECAT_WEBHOOK_AUTH=

# Flutterwave (web checkout, account: 1MINITMAN DATING SERVICES).
# dashboard.flutterwave.com -> Settings -> API keys. Use TEST keys outside production.
FLUTTERWAVE_SECRET_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=
# Settings -> Webhooks -> "Secret hash": type any long random string there and here.
FLUTTERWAVE_WEBHOOK_HASH=

# -----------------------------------------------------------------------------
# 7. Messaging · codes, email, push · [later: auth + notifications]
# -----------------------------------------------------------------------------
# Termii (SMS / WhatsApp codes in Nigeria). accounts.termii.com -> API Token.
# Leave empty locally: codes are printed in the API log instead ("console sink").
TERMII_API_KEY=
TERMII_SENDER_ID=
# Twilio Verify (fallback when Termii is down). console.twilio.com -> Account Info
# (SID, Auth Token) and Verify -> Services -> Create (Service SID).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Resend (email, free tier). resend.com -> API Keys -> Create. Domains -> add and verify
# 1minitman.com before sending from it.
RESEND_API_KEY=
EMAIL_FROM="1minitman <no-reply@1minitman.com>"
# Expo push (optional extra security). expo.dev -> Account settings -> Access tokens,
# then enable "Enhanced security for push notifications" on the project.
EXPO_PUSH_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# 8. Places and calls · [later]
# -----------------------------------------------------------------------------
# Google Places (meet-up venues). console.cloud.google.com -> APIs & Services ->
# enable "Places API (New)" -> Credentials -> Create API key (restrict it to Places).
GOOGLE_PLACES_API_KEY=
# daily.co (Gold calls, after public launch). dashboard.daily.co -> Developers -> API keys.
DAILY_API_KEY=

# -----------------------------------------------------------------------------
# 9. Monitoring and analytics · [later, optional locally]
# -----------------------------------------------------------------------------
# Sentry. sentry.io -> Project -> Settings -> Client Keys (DSN). One project per app.
SENTRY_DSN_API=
SENTRY_DSN_WORKER=
VITE_SENTRY_DSN=
PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# PostHog Cloud EU (free tier, loaded only after consent).
# eu.posthog.com -> Project settings -> Project API key.
VITE_POSTHOG_KEY=
PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# -----------------------------------------------------------------------------
# 10. Hosting and deploys · [later: CI/CD only, never needed on a laptop]
# -----------------------------------------------------------------------------
# Cloudflare. dash.cloudflare.com -> My Profile -> API Tokens -> Create token
# (permissions: Pages edit, DNS edit, R2 edit). Account id is on any zone's overview page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Pages -> the website project -> Settings -> Builds & deployments -> Deploy hooks -> Add.
# The admin console calls this to rebuild the website after a publish.
CLOUDFLARE_PAGES_DEPLOY_HOOK_SITE=
# Railway. railway.com -> Account settings -> Tokens (used by CI to deploy API and worker).
RAILWAY_TOKEN=
