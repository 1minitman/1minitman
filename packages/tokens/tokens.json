  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms",
        "$description": "Press, toggle, chip, toast in. Was 120ms in v1."
      },
      "base": {
        "$type": "duration",
        "$value": "200ms",
        "$description": "Card swipe-out, sheet, fade."
      },
      "slow": {
        "$type": "duration",
        "$value": "250ms",
        "$description": "Match reveal, page transition. Was 320ms in v1."
      },
      "intro": {
        "$type": "duration",
        "$value": "60000ms",
        "$description": "1-Minute Intro countdown."
      },
      "undo-toast": {
        "$type": "duration",
        "$value": "6000ms",
        "$description": "Pass Undo toast visible time."
      },
      "reduced-step": {
        "$type": "duration",
        "$value": "10000ms",
        "$description": "Reduced motion: the 1-Minute ring counts down as a number in 10 s steps."
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Default ease-out for 150-250 ms changes. No bounce, no spring overshoot, no parallax."
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      },
      "ease-out": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.standard}",
        "$description": "Alias of standard."
      },
      "linear": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          1,
          1
        ],
        "$description": "1-Minute ring only."
      }
    },
    "reduced": {
      "$description": "Values when the OS reduce-motion setting is on.",
      "transition": {
        "$type": "string",
        "$value": "cross-fade"
      },
      "duration": {
        "$type": "duration",
        "$value": "150ms"
      },
      "match-animation": {
        "$type": "string",
        "$value": "static-final-frame"
      }
    }
  },
