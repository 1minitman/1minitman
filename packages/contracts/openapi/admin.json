{
  "openapi": "3.1.0",
  "info": {
    "title": "1minitman Admin API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "enum": [
              "local",
              "dev",
              "demo",
              "staging",
              "production"
            ]
          },
          "time": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment",
          "time"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,48}$"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "required",
                    "invalid_format",
                    "too_short",
                    "too_long",
                    "out_of_range",
                    "contact_details",
                    "reserved",
                    "breached",
                    "disposable_email",
                    "voip_blocked",
                    "not_allowed",
                    "self"
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code",
                "message"
              ]
            }
          },
          "entitlement": {
            "type": "string"
          },
          "upsell": {
            "type": "string"
          },
          "permission": {
            "type": "string"
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "until": {
            "type": "string",
            "format": "date-time"
          },
          "tries_left": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "used": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "request_id",
          "reason"
        ]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "degraded"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "up",
                      "down"
                    ]
                  },
                  "latency_ms": {
                    "type": "number"
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "redis": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "up",
                      "down"
                    ]
                  },
                  "latency_ms": {
                    "type": "number"
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "database",
              "redis"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness probe",
        "security": [],
        "x-rate-limit-policy": null,
        "responses": {
          "200": {
            "description": "The service is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "`internal`: Internal error",
            "x-problem-codes": [
              "internal"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness probe (database and Redis)",
        "security": [],
        "x-rate-limit-policy": null,
        "responses": {
          "200": {
            "description": "Every dependency is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "500": {
            "description": "`internal`: Internal error",
            "x-problem-codes": [
              "internal"
            ],
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
