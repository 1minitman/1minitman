{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": ["EXPO_TOKEN", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "openapi:emit": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "../../packages/contracts/src/routes/**",
        "../../packages/contracts/src/schemas/**"
      ],
      "outputs": ["../../packages/contracts/openapi/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "dependsOn": ["@1minitman/api#openapi:emit"],
      "inputs": ["openapi/**", "scripts/**"],
      "outputs": ["src/generated/**"]
    }
  },
  "remoteCache": {
    "enabled": false
  }
}
