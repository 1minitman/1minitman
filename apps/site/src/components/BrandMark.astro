---
// The Pair symbol (assets/brand/1minitman-mark.svg). Colour follows the text colour.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 498 895" aria-hidden="true" class={className}>
  <g fill="currentColor" stroke="currentColor">
    <circle cx="171.5" cy="122.5" r="122.5"></circle>
    <circle cx="326.5" cy="122.5" r="104.5" fill="none" stroke-width="36"></circle>
    <line x1="134.7" y1="422.3" x2="86.3" y2="808.7" stroke-width="172.6" stroke-linecap="round"></line>
    <line x1="363.3" y1="422.3" x2="411.7" y2="808.7" stroke-width="172.6" stroke-linecap="round"></line>
  </g>
</svg>
