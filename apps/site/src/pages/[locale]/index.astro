---
import { DEFAULT_LOCALE, LOCALES, type Locale } from '@1minitman/i18n';
import HomePage from '../../components/HomePage.astro';

// /pcm/ and /fr/. English is served from the root page.
export const getStaticPaths = () =>
  LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({ params: { locale } }));

const locale = Astro.params.locale as Locale;
---

<HomePage locale={locale} />
