---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout locale="en" path="/404" title="Page not found · 1minitman" description="This page does not exist." noindex>
  <section class="mx-auto max-w-(--container-page) px-4 py-24">
    <h1 class="text-[32px] leading-[38px] font-extrabold tracking-[-0.03em]">Page not found</h1>
    <p class="mt-4 text-fg-2">The page you asked for isn't here.</p>
    <a href="/" class="mt-8 inline-flex h-12 items-center rounded-sm bg-inverse-bg px-5 font-bold text-inverse-fg">
      Go to the home page
    </a>
  </section>
</BaseLayout>
