{
  "name": "@1minitman/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background jobs on pg-boss (queue stored in PostgreSQL). One file per job in src/jobs.",
  "scripts": {
    "dev": "bun --env-file=../../.env.development --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --minify-syntax",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@1minitman/contracts": "workspace:*",
    "@1minitman/db": "workspace:*",
    "pg-boss": "^12.39.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "bun": "catalog:",
    "typescript": "catalog:"
  }
}
