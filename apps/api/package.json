{
  "name": "@1minitman/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The API service: Hono on Bun. Surfaces /v1 (members), /public/v1 (website), /admin/v1 (staff), /webhooks (vendors).",
  "scripts": {
    "dev": "bun --env-file=../../.env.development --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --minify-syntax",
    "openapi:emit": "bun src/cli/emit-openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@1minitman/contracts": "workspace:*",
    "@1minitman/db": "workspace:*",
    "@1minitman/entitlements": "workspace:*",
    "@1minitman/i18n": "workspace:*",
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "^0.12.24",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "bun": "catalog:",
    "typescript": "catalog:"
  }
}
